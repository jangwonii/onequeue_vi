{
  "name": "onequeue-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Requirement coverage and evidence-based release gates for MCP agents",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "verify:hankan": "node scripts/verify-hankan.mjs",
    "verify:bookmark": "node scripts/verify-bookmark.mjs",
    "verify:promise": "node scripts/verify-promise.mjs",
    "verify:promise-release": "node scripts/verify-promise-release.mjs",
    "verify:promise-production": "node scripts/verify-promise-production.mjs",
    "client-config": "node scripts/client-config.mjs",
    "status": "node scripts/status.mjs",
    "verify:regression-detectors": "node scripts/verify-regression-detectors.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.1",
    "zod": "^3.25.76"
  }
}
